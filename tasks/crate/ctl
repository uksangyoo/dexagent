#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
export CUDA_VISIBLE_DEVICES=1
# Warp and Cycles/OptiX see only physical GPU 1.
export ROBOSIMSTUDIO_RENDERER=cycles
export VK_ICD_FILENAMES=/etc/vulkan/icd.d/nvidia_icd.json
export PYTHONPATH="$root:$root/third-party/robosimstudio"
export PYTHON="${PYTHON:-/home/uyoo/Projects/physgram/robosimstudio/.venv/bin/python}"
cd "$root/third-party/robosimstudio"
exec examples/live/ctl "$@"
