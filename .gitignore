# Python
.venv*/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Environment
.env
.env.*
!.env.example

# Logs
*.log
MUJOCO_LOG.TXT

# Build output
/build/
/dist/

# Generated outputs (films, results)
/artifacts/

# Published site (separate git repository)
/screwdriver_site/

